# Backend runtime configuration (set real values in Azure Container Apps secrets/settings).
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=nexora
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://api.example.com/api/auth/google/callback
FRONTEND_URL=https://app.example.com
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Optional independent fallback. A Featherless key cannot be replaced with an OpenRouter key.
FEATHERLESS_API_KEY=your-featherless-api-key
FEATHERLESS_MODEL=Qwen/Qwen3-0.6B
